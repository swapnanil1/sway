#!/usr/bin/env bash
# Put every connected output on its largest mode at the highest refresh rate it
# offers. Output names differ between ports and GPUs, so nothing is hardcoded.
# sway alone would pick the preferred mode, which is often not the fastest.

swaymsg -t get_outputs | jq -r '
	.[] | select(.active and (.modes | length > 0)) |
	.name as $name |
	(.modes | max_by([.width * .height, .refresh])) as $m |
	"\($name) \($m.width)x\($m.height)@\($m.refresh / 1000)Hz"
' | while read -r output mode; do
	swaymsg -q output "$output" mode "$mode"
done
