#!/usr/bin/env bash
# Focus an open window whose app_id or class matches a regex, otherwise run the
# command.
#   focus-or-launch '<regex>' <command...>
#   focus-or-launch --browser        any browser window, else the default browser

if [[ $1 == --browser ]]; then
	desktop=$(xdg-settings get default-web-browser 2>/dev/null)
	set -- '(?i)brave|firefox|chromium|librewolf|zen' gtk-launch "${desktop:-firefox.desktop}"
fi

re=$1; shift
for crit in app_id class; do
	swaymsg "[$crit=\"$re\"] focus" 2>/dev/null | jq -e '.[0].success' >/dev/null 2>&1 && exit 0
done
exec "$@"
