#!/usr/bin/env bash
# Uses ~/.config/sway/wallpaper.{png,jpg,jpeg,webp} or ~/Pictures/wallpaper.* if
# one exists, otherwise paints the theme background colour. sway draws it
# through swaybg; nothing else to run.

for img in ~/.config/sway/wallpaper.{png,jpg,jpeg,webp} ~/Pictures/wallpaper.{png,jpg,jpeg,webp}; do
	if [[ -f $img ]]; then
		exec swaymsg -q output '*' bg "$img" fill
	fi
done

[ -f ~/.config/sway/theme.env ] && . ~/.config/sway/theme.env
exec swaymsg -q output '*' bg "${BG:-#1e222a}" solid_color
