#!/usr/bin/env bash
# Switch the colour palette of everything listed in themes/targets.conf.
#
#   theme                      pick a palette in wofi
#   theme <name>               apply themes/palettes/<name>.conf
#   theme --list
#   theme --check              validate palettes and templates, write nothing
#   theme --ensure             rewrite the generated files if any is missing
#   theme --no-reload <name>   only write the files (used by install.sh)
#
#   themes/palettes/*.conf   one palette per file: KEY=#rrggbb
#   themes/templates/*       one colour file per tool, with ${KEY} placeholders;
#                            ${KEY_HEX} is the same colour without the "#"
#                            (foot, swaylock), ${KEY_RGB} is "r,g,b" (KDE);
#                            ${HOME} for tools that take no "~" in paths
#   themes/targets.conf      which template goes where, and how to reload it
#
# Everything written is generated and git-ignored: edit palettes and templates.

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
KEYS=(BG BG_ALT FG FG_DIM ACCENT SELECTION BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE ORANGE)
RELOAD=1

[[ $1 == --no-reload ]] && { RELOAD=0; shift; }
if [[ $1 == --list ]]; then
	for f in "$ROOT"/themes/palettes/*.conf; do basename "$f" .conf; done
	exit 0
fi

# --ensure: the generated files are not in git, so they can go missing (fresh
# clone, git clean, a rebase). Rewrite them all if any target is absent.
if [[ $1 == --ensure ]]; then
	while IFS='|' read -r template target _; do
		target=${target// /}
		[[ -z ${template// /} || $template == \#* || -f $ROOT/$target ]] && continue
		current=$(sed -n 's/^THEME=//p' "$ROOT/sway/theme.env" 2>/dev/null)
		exec "$0" --no-reload "${current:-onedark}"
	done <"$ROOT/themes/targets.conf"
	exit 0
fi

# --check: validate every palette and template without writing anything
if [[ $1 == --check ]]; then
	status=0
	for f in "$ROOT"/themes/palettes/*.conf; do
		for key in "${KEYS[@]}"; do
			grep -qE "^$key=#[0-9a-fA-F]{6}$" "$f" || { echo "$f: $key missing or not #rrggbb"; status=1; }
		done
	done
	known=$(for k in "${KEYS[@]}"; do printf '%s|%s_HEX|%s_RGB|' "$k" "$k" "$k"; done)THEME\|THEME_HEADER\|HOME
	while IFS='|' read -r template target _; do
		template=${template// /}
		[[ -z $template || $template == \#* ]] && continue
		[[ -f $ROOT/themes/templates/$template ]] || { echo "targets.conf: no template $template"; status=1; continue; }
		grep -oE '\$\{[A-Z_]+\}' "$ROOT/themes/templates/$template" | sort -u | grep -vE "^\\$\{($known)\}$" |
			sed "s|^|templates/$template: unknown placeholder |" | grep . && status=1
	done <"$ROOT/themes/targets.conf"
	exit $status
fi

THEME=$1
if [[ -z $THEME ]]; then
	THEME=$("$0" --list | wofi --dmenu -i -p "Theme" --lines 9) || exit 0
fi
[[ $THEME =~ ^[a-z0-9_-]+$ ]] || { echo "bad theme name: $THEME" >&2; exit 1; }
palette="$ROOT/themes/palettes/$THEME.conf"
[[ -f $palette ]] || { echo "no such theme: $THEME (see: ${0##*/} --list)" >&2; exit 1; }

# Palettes are data, not scripts: accept KEY=#rrggbb lines and nothing else
while IFS='=' read -r key value; do
	if [[ $key =~ ^[A-Z_]+$ && $value =~ ^#[0-9a-fA-F]{6}$ ]]; then
		hex=${value#\#}
		export "$key=$value" "${key}_HEX=$hex" \
			"${key}_RGB=$((16#${hex:0:2})),$((16#${hex:2:2})),$((16#${hex:4:2}))"
	fi
done <"$palette"
for key in "${KEYS[@]}"; do
	[[ -n ${!key} ]] || { echo "$palette: $key is missing or not #rrggbb" >&2; exit 1; }
done
export THEME THEME_HEADER="generated by sway/scripts/theme from themes/palettes/$THEME.conf - do not edit"

# Only these names are substituted, so a template may use any other $variable
vars=$(for k in "${KEYS[@]}"; do printf '${%s} ${%s_HEX} ${%s_RGB} ' "$k" "$k" "$k"; done)
vars="$vars \${THEME} \${THEME_HEADER} \${HOME}"

reloads=()
while IFS='|' read -r template target reload; do
	template=${template// /}; target=${target// /}
	[[ -z $template || $template == \#* ]] && continue
	mkdir -p "$(dirname "$ROOT/$target")"
	envsubst "$vars" <"$ROOT/themes/templates/$template" >"$ROOT/$target"
	reload=$(sed 's/^ *//; s/ *$//' <<<"$reload")
	[[ -n $reload ]] && reloads+=("$reload")
done <"$ROOT/themes/targets.conf"

((RELOAD)) || exit 0
for cmd in "${reloads[@]}"; do
	eval "$cmd" >/dev/null 2>&1
done
~/.config/sway/scripts/sound theme
notify-send -a sway-quiet -t 2500 "Theme" "$THEME"
