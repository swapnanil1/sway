#!/usr/bin/env bash
# Pomodoro for waybar: 25 minutes of work, 5 minutes of break, repeating.
#
#   pomo                 bar loop (waybar exec): one JSON line per change
#   pomo toggle          start, or pause/resume           (left click, Mod+Shift+Z)
#   pomo stop            stop and reset                   (right click)
#   pomo break           take a break right now           (middle click)
#   pomo skip            end the break now                (Mod+Ctrl+Shift+B)
#   pomo stats           the last 7 days, as a notification (scroll on the timer)
#
# A minute before a break a notification warns you; when the break starts,
# scripts/break-screen takes over the screen until it ends. In game mode the
# break is only announced, never enforced.
#
# Only finished blocks are counted: a full 25 minutes of work (pausing and
# resuming is fine) and a full 5 minute break. Stopping or skipping midway
# counts nothing. One line per day, kept forever, in plain text:
#   ~/.local/state/pomo/history     2026-09-19 work=4 breaks=3
#
# After a scheduled break the next work session starts by itself. After a break
# you asked for (middle click) the timer stops and waits for a left click.
#
# The bar loop is the one resident process of this feature. While the timer is
# stopped it sleeps until a click or key wakes it, so it costs nothing idle.

# State lives in the per-user runtime dir (mode 0700), not in /tmp where any
# local user could plant or symlink these files.
STATE_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/pomo"
mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
STATE_FILE="$STATE_DIR/state"
END_TIME_FILE="$STATE_DIR/end_time"
PAUSED_TIME_FILE="$STATE_DIR/paused_time"
LOOP_PID_FILE="$STATE_DIR/loop_pid"
MANUAL_BREAK_FILE="$STATE_DIR/manual_break"
GAMEMODE_FILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/gamemode"

# Survives reboots and is not part of the dotfiles
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/pomo/history"

# Bash arithmetic evaluates its operands, so file contents go through this first
read_int() { local v=; [[ -r $1 ]] && v=$(<"$1"); [[ $v =~ ^[0-9]+$ ]] && echo "$v" || echo 0; }
POMO_DURATION_MIN=25
BREAK_DURATION_MIN=5

ICON_RUNNING="󰔟"
ICON_PAUSED="󰏤"
ICON_BREAK="󰅶"
ICON_STOPPED="󰔛"

# today_count work|breaks  ->  number for today (0 if none)
today_count() {
	local line; line=$(grep -s "^$(date +%F) " "$HISTORY_FILE" | tail -n1)
	[[ $line =~ $1=([0-9]+) ]] && echo "${BASH_REMATCH[1]}" || echo 0
}
# count work|breaks  ->  add one to today's line
count() {
	local today work breaks; today=$(date +%F)
	work=$(today_count work); breaks=$(today_count breaks)
	[[ $1 == work ]] && work=$((work + 1)) || breaks=$((breaks + 1))
	mkdir -p "$(dirname "$HISTORY_FILE")"
	{ grep -sv "^$today " "$HISTORY_FILE"; echo "$today work=$work breaks=$breaks"; } >"$HISTORY_FILE.tmp" &&
		mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}
# "4w 3b 1h40" for today, empty before the first finished block
today_summary() {
	local work breaks mins; work=$(today_count work); breaks=$(today_count breaks)
	((work + breaks == 0)) && return
	mins=$((work * POMO_DURATION_MIN))
	printf '  %dw %db %dh%02d' "$work" "$breaks" $((mins / 60)) $((mins % 60))
}
action_stats() {
	local body
	body=$(tail -n 7 "$HISTORY_FILE" 2>/dev/null | while read -r day w b; do
		w=${w#work=}; b=${b#breaks=}
		printf '%s   %2d work  %2d breaks  %dh%02d\n' "$day" "$w" "$b" $((w * POMO_DURATION_MIN / 60)) $((w * POMO_DURATION_MIN % 60))
	done)
	notify-send -t 10000 "Pomodoro, last 7 days" "${body:-nothing finished yet}"
}

get_state() { if [[ -s $STATE_FILE ]]; then cat "$STATE_FILE"; else echo "stopped"; fi; }
set_state() { echo "$1" >"$STATE_FILE"; }
format_time() { local s=$1; ((s < 0)) && s=0; printf "%02d:%02d" $((s / 60)) $((s % 60)); }
# Through the shared event sounds, so the sounds switch and game mode apply
play_sound() { ~/.config/sway/scripts/sound pomodoro; }
send_notification() { notify-send "$1" "$2" -i "$3" -u "$4" -t 5000; }
start_break_screen() { [[ -e $GAMEMODE_FILE ]] || setsid -f ~/.config/sway/scripts/break-screen start >/dev/null 2>&1; }

action_start_pomo() {
	rm -f "$MANUAL_BREAK_FILE"
	echo $((EPOCHSECONDS + POMO_DURATION_MIN * 60)) >"$END_TIME_FILE"
	rm -f "$PAUSED_TIME_FILE"
	set_state "running"
}
action_start_break() {
	echo $((EPOCHSECONDS + BREAK_DURATION_MIN * 60)) >"$END_TIME_FILE"
	rm -f "$PAUSED_TIME_FILE"
	set_state "break_running"
}
# A scheduled break rolls into the next work session; a requested one stops.
action_end_break() {
	if [[ -e $MANUAL_BREAK_FILE ]]; then
		action_stop
	else
		action_start_pomo
	fi
}
action_take_break() {
	action_start_break
	touch "$MANUAL_BREAK_FILE"
	start_break_screen
}
action_stop() {
	set_state "stopped"
	rm -f "$END_TIME_FILE" "$PAUSED_TIME_FILE" "$MANUAL_BREAK_FILE"
}

action_toggle_pause() {
	local state remaining end_time
	state=$(get_state)
	case "$state" in
		running)
			end_time=$(read_int "$END_TIME_FILE")
			echo $((end_time - EPOCHSECONDS)) >"$PAUSED_TIME_FILE"
			set_state "paused"
			;;
		paused)
			remaining=$(read_int "$PAUSED_TIME_FILE")
			echo $((EPOCHSECONDS + remaining)) >"$END_TIME_FILE"
			set_state "running"
			;;
		break_running)
			end_time=$(read_int "$END_TIME_FILE")
			echo $((end_time - EPOCHSECONDS)) >"$PAUSED_TIME_FILE"
			set_state "break_paused"
			;;
		break_paused)
			remaining=$(read_int "$PAUSED_TIME_FILE")
			echo $((EPOCHSECONDS + remaining)) >"$END_TIME_FILE"
			set_state "break_running"
			;;
	esac
}

# One JSON line for waybar: the "class" (running, paused, break, stopped)
# picks the colour in waybar/style.css
action_display() {
	local state class icon text end_time remaining
	state=$(get_state)
	case "$state" in
		running)
			end_time=$(read_int "$END_TIME_FILE"); remaining=$((end_time - EPOCHSECONDS))
			if ((remaining <= 0)); then
				count work
				play_sound; action_start_break
				if [[ -e $GAMEMODE_FILE ]]; then
					send_notification "Pomodoro finished" "Break time: ${BREAK_DURATION_MIN} minutes." "clock-symbolic" "critical"
				else
					start_break_screen
				fi
				action_display; return
			fi
			((remaining == 60)) && send_notification "Break in 1 minute" "Wrap up what you are doing." "clock-symbolic" "normal"
			class=running; icon=$ICON_RUNNING; text=$(format_time "$remaining") ;;
		paused)
			remaining=$(read_int "$PAUSED_TIME_FILE")
			class=paused; icon=$ICON_PAUSED; text=$(format_time "$remaining") ;;
		break_running)
			end_time=$(read_int "$END_TIME_FILE"); remaining=$((end_time - EPOCHSECONDS))
			if ((remaining <= 0)); then
				if [[ -e $MANUAL_BREAK_FILE ]]; then
					send_notification "Break over" "Left click the timer to start working." "appointment-soon-symbolic" "normal"
				else
					send_notification "Break over" "${POMO_DURATION_MIN} minutes of work, starting now." "appointment-soon-symbolic" "normal"
				fi
				count breaks
				play_sound; action_end_break
				action_display; return
			fi
			class=break; icon=$ICON_BREAK; text=$(format_time "$remaining") ;;
		break_paused)
			remaining=$(read_int "$PAUSED_TIME_FILE")
			class=paused; icon=$ICON_BREAK; text=$(format_time "$remaining") ;;
		*)
			class=stopped; icon=$ICON_STOPPED; text="" ;;
	esac
	printf '{"text": "%s%s%s", "class": "%s", "tooltip": "Pomodoro: %s"}\n' \
		"$icon" "${text:+ $text}" "$(today_summary)" "$class" "$class"
}

if [[ -n $1 ]]; then
	case "$1" in
		start)        action_start_pomo ;;
		toggle)       if [[ $(get_state) == stopped ]]; then action_start_pomo; else action_toggle_pause; fi ;;
		toggle_pause) action_toggle_pause ;;
		stop)         action_stop ;;
		break)        action_take_break ;;
		stats)        action_stats; exit 0 ;;
		skip)         case "$(get_state)" in break_running | break_paused) action_end_break ;; esac ;;
		*)            echo "usage: ${0##*/} [toggle|stop|break|skip|stats]" >&2; exit 2 ;;
	esac
	# wake the bar loop so the change shows immediately
	pid=$(read_int "$LOOP_PID_FILE"); ((pid > 1)) && kill -USR1 "$pid" 2>/dev/null
	exit 0
fi

# Bar loop for the waybar module: a line whenever something changes, once a
# second while a timer runs, and immediately when a click or keybind (handled
# above) sends SIGUSR1. Stopped, it sleeps until woken.
echo $$ >"$LOOP_PID_FILE"
trap 'rm -f "$LOOP_PID_FILE"; kill $! 2>/dev/null' EXIT
trap ':' USR1
while true; do
	action_display
	if [[ $(get_state) == stopped ]]; then
		sleep infinity &
	else
		sleep 1 &
	fi
	wait $!
	kill $! 2>/dev/null
done
