# Session environment, sourced by /usr/local/bin/sway-desktop (installed by
# install.sh) right before sway starts, so every app launched from sway sees it.
# POSIX sh: no bashisms.

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-sway}"
export XDG_SESSION_TYPE=wayland

# Qt: native Wayland, qt6ct picks the Breeze style, icons and palette
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=qt6ct

# KDE apps build their application list from a menu definition; outside Plasma
# the one from archlinux-xdg-menu is used (Dolphin's Open With is empty without it)
export XDG_MENU_PREFIX=arch-

# Firefox and Electron on native Wayland (Chromium-family browsers read
# ~/.config/<browser>-flags.conf instead; see seeds/browser)
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Java apps misbehave with a non-reparenting WM unless told
export _JAVA_AWT_WM_NONREPARENTING=1

# No accessibility bus: without these, the first GTK app spawns at-spi's
# launcher, registry and a private D-Bus that then stay for the session.
# Remove both lines if you use a screen reader.
export NO_AT_BRIDGE=1
export GTK_A11Y=none

# A non-UTF-8 locale (e.g. LANG=en_IN) breaks htop, Compose keys and
# notification text. Prefer the UTF-8 variant of the same locale when it exists.
case "$LANG" in
	*.UTF-8 | *.utf8) ;;
	*)
		if locale -a 2>/dev/null | grep -qix "${LANG:-en_US}.utf8"; then
			export LANG="${LANG:-en_US}.UTF-8"
		else
			export LANG=C.UTF-8
		fi
		;;
esac
