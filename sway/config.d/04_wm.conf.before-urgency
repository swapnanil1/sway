## Window management
## Left hand: thumb on Mod, fingers on W A S D. The J K L ; keys still work.

floating_modifier $mod normal
tiling_drag enable

#: Close window
bindsym $mod+Shift+q kill
#: Reload the sway config
bindsym $mod+Shift+c reload
## sway has no in-place restart; the i3 key reloads instead
#: Reload the sway config
bindsym $mod+Shift+r reload

##-- Focus ---------------------------------

#: Focus up
bindsym $mod+w focus up
#: Focus left
bindsym $mod+a focus left
#: Focus down
bindsym $mod+s focus down
#: Focus right
bindsym $mod+d focus right

##-- Move ----------------------------------

#: Move window up
bindsym $mod+Shift+w move up
#: Move window left
bindsym $mod+Shift+a move left
#: Move window down
bindsym $mod+Shift+s move down
#: Move window right
bindsym $mod+Shift+d move right

##-- Layout --------------------------------

#: Fullscreen
bindsym $mod+f fullscreen toggle
#: Float / tile the window
bindsym $mod+Shift+f floating toggle
#: Toggle split layout
bindsym $mod+z layout toggle split
#: Tabbed layout
bindsym $mod+x layout tabbed

##-- Resize --------------------------------

#: Resize mode
bindsym $mod+r mode "resize"

mode "resize" {
        #: Narrower
        bindsym a resize shrink width 10 px or 10 ppt
        #: Wider
        bindsym d resize grow width 10 px or 10 ppt
        #: Shorter
        bindsym w resize shrink height 10 px or 10 ppt
        #: Taller
        bindsym s resize grow height 10 px or 10 ppt

        #: Leave resize mode
        bindsym Return mode "default"
        #: Leave resize mode
        bindsym Escape mode "default"
        #: Leave resize mode
        bindsym r mode "default"
}

##-- Right-hand fallbacks ------------------

#: Focus left
bindsym $mod+j focus left
#: Focus down
bindsym $mod+k focus down
#: Focus up
bindsym $mod+l focus up
#: Focus right
bindsym $mod+semicolon focus right
#: Move window left
bindsym $mod+Shift+j move left
#: Move window down
bindsym $mod+Shift+k move down
#: Move window up
bindsym $mod+Shift+l move up
#: Move window right
bindsym $mod+Shift+semicolon move right
