# Dolphin context menu: "Extract here" on archives. install.sh writes this to
# ~/.local/share/kio/servicemenus/ with @HOME@ filled in (Exec lines expand
# neither ~ nor $HOME) and makes it executable, which KIO requires. The whole
# selection goes to one run of sway/scripts/extract-here.
[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/x-tar;application/x-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lz4-compressed-tar;application/x-lzma-compressed-tar;application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-cpio;application/gzip;application/x-xz;application/zstd;application/x-bzip2;
Actions=extractHere
X-KDE-Priority=TopLevel
Icon=archive-extract

[Desktop Action extractHere]
Name=Extract here
Icon=archive-extract
Exec=@HOME@/.config/sway/scripts/extract-here %F
