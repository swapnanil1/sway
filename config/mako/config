# mako: notifications. Colours are generated by bin/theme.
include=~/.cache/sway-desktop/mako

font=JetBrainsMono Nerd Font 11
width=420
height=160
margin=10
padding=12
border-size=2
border-radius=10
icons=1
max-icon-size=40
default-timeout=5000
anchor=top-right
layer=overlay

# every notification gets an event sound; bin/sound decides if it is audible
on-notify=exec ~/.local/share/sway-desktop/bin/sound notify

[urgency=low]
default-timeout=2500
on-notify=none

[urgency=critical]
default-timeout=0
on-notify=exec ~/.local/share/sway-desktop/bin/sound notify-critical

# our own scripts play their own sound
[app-name=sway-desktop]
on-notify=none

# game mode and pomodoro breaks
[mode=do-not-disturb]
invisible=1
on-notify=none
