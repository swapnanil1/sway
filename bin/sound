#!/usr/bin/env bash
# Event sounds from a freedesktop sound theme.
#
#   sound <event>            play it (silent when sounds are off or in game mode)
#   sound --wait <event>     same, but return only when it has finished
#   sound on | off | toggle | status
#   sound volume-keys on | off      the blip on volume keys has its own switch
#
# Events: notify notify-critical screenshot login logout gamemode-on gamemode-off
#         theme device-added device-removed volume error pomodoro

. "$(dirname "$(readlink -f "$0")")/lib/common.sh"

THEMES=(ocean freedesktop)     # first theme that has the event wins
LEVEL=0.6                      # 0.0 - 1.0, relative to the system volume

case "${1:-}" in
	on | off) save sound enabled "$1"; exit ;;
	toggle) [[ $(setting sound enabled) == off ]] && exec "$0" on || exec "$0" off ;;
	status) echo "sounds: $(setting sound enabled | grep . || echo on)   volume keys: $(setting sound volume_keys | grep . || echo off)"; exit ;;
	volume-keys) [[ ${2:-} == on || ${2:-} == off ]] || die "usage: sound volume-keys on|off"; save sound volume_keys "$2"; exit ;;
esac

wait_for_it=0
[[ ${1:-} == --wait ]] && { wait_for_it=1; shift; }

[[ $(setting sound enabled) == off ]] && exit 0
is_gaming && [[ ${1:-} != gamemode-off ]] && exit 0

case "${1:-}" in
	notify)          event=message-new-instant ;;
	notify-critical) event=dialog-warning ;;
	screenshot)      event=screen-capture ;;
	login)           event=desktop-login ;;
	logout)          event=desktop-logout ;;
	gamemode-on)     event=service-login ;;
	gamemode-off)    event=service-logout ;;
	theme)           event=outcome-success ;;
	device-added)    event=device-added ;;
	device-removed)  event=device-removed ;;
	error)           event=dialog-error ;;
	pomodoro)        event=alarm-clock-elapsed ;;
	volume)
		[[ $(setting sound volume_keys) == on ]] || exit 0
		# a held key repeats ~30 times a second; one blip per 120 ms is plenty
		now=$(date +%s%N); last=$(cat "$RUNTIME/sound-volume" 2>/dev/null)
		[[ $last =~ ^[0-9]+$ ]] && ((now - last < 120000000)) && exit 0
		echo "$now" >"$RUNTIME/sound-volume"
		event=audio-volume-change ;;
	*) die "unknown event: ${1:-} (see the header of this script)" ;;
esac

for theme in "${THEMES[@]}"; do
	file=/usr/share/sounds/$theme/stereo/$event.oga
	[[ -f $file ]] || continue
	if ((wait_for_it)); then timeout 3 pw-play --volume "$LEVEL" "$file" >/dev/null 2>&1
	else setsid -f pw-play --volume "$LEVEL" "$file" >/dev/null 2>&1; fi
	exit 0
done
