#!/usr/bin/env bash
# Monitor brightness over DDC/CI (ddcutil). The value is cached, so the bar never
# polls the I2C bus, and rapid key or scroll events collapse into one write.
#
#   brightness up | down | set <0-100> | toggle | menu
#   brightness json      what waybar shows (refreshed by signal, not by polling)

. "$(dirname "$(readlink -f "$0")")/lib/common.sh"

STEP=5
NIGHT=30                       # "toggle" flips between this and the last value
WAYBAR_SIGNAL=8                # matches "signal" in config/waybar/config.jsonc
DIR="$RUNTIME/brightness"; mkdir -p "$DIR"

int() { [[ ${1:-} =~ ^[0-9]+$ ]]; }

# the I2C bus number can change between boots; $RUNTIME is per boot
bus() {
	int "$(cat "$DIR/bus" 2>/dev/null)" || ddcutil detect --brief 2>/dev/null |
		sed -n 's|.*I2C bus: */dev/i2c-\([0-9]\+\).*|\1|p' | head -n1 >"$DIR/bus"
	int "$(<"$DIR/bus")" && echo "--bus $(<"$DIR/bus")"
}
current() {
	int "$(cat "$DIR/value" 2>/dev/null)" ||
		ddcutil $(bus) --terse getvcp 10 2>/dev/null | awk '$1 == "VCP" { print $4 }' >"$DIR/value"
	cat "$DIR/value"
}
change() {
	local cur new target
	exec 9>"$DIR/lock"; flock 9
	cur=$(current); int "$cur" || die "no DDC/CI monitor found"
	case "$1" in up) new=$((cur + STEP)) ;; down) new=$((cur - STEP)) ;; *) new=$1 ;; esac
	((new > 100)) && new=100; ((new < 0)) && new=0
	echo "$new" >"$DIR/value"; flock -u 9
	pkill -RTMIN+$WAYBAR_SIGNAL -x waybar 2>/dev/null

	# whoever holds the hardware lock writes the latest value; queued callers find nothing left to do
	exec 8>"$DIR/hwlock"; flock 8
	target=$(<"$DIR/value"); int "$target" || return
	[[ $target == "$(cat "$DIR/applied" 2>/dev/null)" ]] && return
	ddcutil $(bus) --noverify setvcp 10 "$target" >/dev/null 2>&1 && echo "$target" >"$DIR/applied"
}

case "${1:-}" in
	json)
		need ddcutil; v=$(current)
		if int "$v"; then printf '{"text":"󰃟 %s%%","tooltip":"Monitor brightness %s%%\\nScroll: step   Left: presets   Right: day/night"}\n' "$v" "$v"
		else printf '{"text":"","tooltip":"no DDC/CI monitor"}\n'; fi ;;
	up | down) need ddcutil; change "$1" ;;
	set) need ddcutil; int "${2:-}" || die "usage: brightness set <0-100>"; change "$2" ;;
	toggle)
		need ddcutil; cur=$(current)
		if [[ $cur == "$NIGHT" ]]; then day=$(cat "$DIR/day" 2>/dev/null); int "$day" || day=100; change "$day"
		else echo "$cur" >"$DIR/day"; change "$NIGHT"; fi ;;
	menu) need ddcutil fuzzel; pick=$(printf '%s\n' 100 75 50 25 10 | fuzzel --dmenu --prompt "brightness  ") || exit 0; int "$pick" && change "$pick" ;;
	*) die "usage: brightness up|down|set <n>|toggle|menu|json" ;;
esac
