#!/usr/bin/env bash
# Keybindings live in keys/*.keys (see keys/README). This turns them into sway
# config, a searchable list and documentation: one source, three uses.
#
#   keys build     write the sway config that is actually loaded
#   keys list      searchable list; Enter runs the selected binding
#   keys doc       print the bindings as a Markdown table
#   keys --check   validate the tables, write nothing

. "$(dirname "$(readlink -f "$0")")/lib/common.sh"

# rows: emit "file|mode|keys|description|command", trimmed, comments removed
rows() {
	awk -F'|' '
		FNR == 1 { group = FILENAME; sub(/.*\//, "", group); sub(/^[0-9]+-/, "", group); sub(/\.keys$/, "", group) }
		/^[ \t]*(#|$)/ { next }
		{
			for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
			# the command may itself contain "|": rejoin everything after field 3
			cmd = $4; for (i = 5; i <= NF; i++) cmd = cmd "|" $i
			print group "|" $1 "|" $2 "|" $3 "|" cmd
		}' "$ROOT"/keys/*.keys
}

check() {
	rows | awk -F'|' '
		NF < 5 || $2 == "" || $3 == "" || $4 == "" || $5 == "" { printf "keys/%s: incomplete line for \"%s\"\n", $1, $3; bad = 1 }
		{ key = $3; sub(/^--[a-z-]+ +/, "", key); id = $2 " " key
		  if (id in seen) { printf "duplicate binding in mode %s: %s\n", $2, key; bad = 1 } seen[id] = 1 }
		END { exit bad }'
}

case "${1:-}" in
	build)
		check || die "keys tables are invalid, keeping the previous bindings"
		{
			echo "# generated by bin/keys from keys/*.keys - do not edit"
			rows | awk -F'|' '$2 == "default" { printf "bindsym %s %s\n", $3, $5 }'
			for mode in $(rows | awk -F'|' '$2 != "default" { print $2 }' | sort -u); do
				printf '\nmode "%s" {\n' "$mode"
				rows | awk -F'|' -v m="$mode" '$2 == m { printf "\tbindsym %s %s\n", $3, $5 }'
				echo "}"
			done
		} >"$CACHE/keys.conf.tmp" && mv "$CACHE/keys.conf.tmp" "$CACHE/keys.conf"
		;;
	list)
		need fuzzel swaymsg
		choice=$(rows | awk -F'|' '{
			key = $3; sub(/^--[a-z-]+ +/, "", key); gsub(/\$mod/, "Mod", key)
			if ($2 != "default") key = $2 ": " key
			printf "%-22s %s\n", key, $4 }' | fuzzel --dmenu --prompt "keys  " --width 60) || exit 0
		# find the row again by its rendered text and run its command
		rows | awk -F'|' -v want="$choice" '{
			key = $3; sub(/^--[a-z-]+ +/, "", key); gsub(/\$mod/, "Mod", key)
			if ($2 != "default") key = $2 ": " key
			if (sprintf("%-22s %s", key, $4) == want) { print $5; exit } }' |
			sed "s|\$bin|$BIN|g" | { read -r cmd && swaymsg -q -- "$cmd"; }
		;;
	doc)
		echo "| Keys | Action |"; echo "| --- | --- |"
		rows | awk -F'|' '{
			key = $3; sub(/^--[a-z-]+ +/, "", key); gsub(/\$mod/, "Mod", key)
			if ($2 != "default") key = "(" $2 ") " key
			printf "| `%s` | %s |\n", key, $4 }'
		;;
	--check) check ;;
	*) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
