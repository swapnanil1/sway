#!/usr/bin/env bash
# Switch the colour palette of everything listed in themes/targets.conf.
#
#   theme                      pick a palette
#   theme <name>               apply themes/palettes/<name>.conf
#   theme --list
#   theme --check              validate palettes and templates, write nothing
#   theme --ensure             write the generated files if any is missing
#   theme --no-reload <name>   write the files only
#
# Output goes to ~/.cache/sway-desktop and is never part of the repository.

. "$(dirname "$(readlink -f "$0")")/lib/common.sh"

KEYS=(BG BG_ALT FG FG_DIM ACCENT SELECTION BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE ORANGE)
DEFAULT=onedark

# targets: emit "template|file|reload", trimmed
targets() {
	awk -F'|' '/^[ \t]*(#|$)/ { next }
		{ for (i = 1; i <= 3; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i); print $1 "|" $2 "|" $3 }' "$ROOT/themes/targets.conf"
}
list() { for f in "$ROOT"/themes/palettes/*.conf; do basename "$f" .conf; done; }
current() { sed -n 's/^THEME=//p' "$CACHE/theme.env" 2>/dev/null; }

check() {
	local status=0 f key known
	for f in "$ROOT"/themes/palettes/*.conf; do
		for key in "${KEYS[@]}"; do
			grep -qE "^$key=#[0-9a-fA-F]{6}$" "$f" || { echo "${f#"$ROOT"/}: $key missing or not #rrggbb"; status=1; }
		done
	done
	known=$(for key in "${KEYS[@]}"; do printf '%s|%s_HEX|' "$key" "$key"; done)THEME\|THEME_HEADER
	while IFS='|' read -r template _ _; do
		[[ -f $ROOT/themes/templates/$template ]] || { echo "targets.conf: no template $template"; status=1; continue; }
		grep -oE '\$\{[A-Z_]+\}' "$ROOT/themes/templates/$template" | sort -u |
			grep -vE "^\\\$\{(${known//\\|/|})\}$" | sed "s|^|templates/$template: unknown placeholder |" | grep . && status=1
	done < <(targets)
	return $status
}

apply() {   # apply <name> <reload: 0|1>
	local name=$1 reload=$2 palette key value
	[[ $name =~ ^[a-z0-9_-]+$ ]] || die "bad theme name: $name"
	palette="$ROOT/themes/palettes/$name.conf"
	[[ -f $palette ]] || die "no such theme: $name (see: theme --list)"

	# palettes are data, not scripts: accept KEY=#rrggbb lines and nothing else
	while IFS='=' read -r key value; do
		[[ $key =~ ^[A-Z_]+$ && $value =~ ^#[0-9a-fA-F]{6}$ ]] || continue
		export "$key=$value" "${key}_HEX=${value#\#}"
	done <"$palette"
	for key in "${KEYS[@]}"; do [[ -n ${!key:-} ]] || die "$name: $key is missing or not #rrggbb"; done
	export THEME=$name THEME_HEADER="generated by bin/theme from themes/palettes/$name.conf - do not edit"

	# only these names are substituted, so templates may use any other $variable
	local vars; vars=$(for key in "${KEYS[@]}"; do printf '${%s} ${%s_HEX} ' "$key" "$key"; done)'${THEME} ${THEME_HEADER}'
	local reloads=() template file cmd
	while IFS='|' read -r template file cmd; do
		envsubst "$vars" <"$ROOT/themes/templates/$template" >"$CACHE/$file"
		[[ -n $cmd ]] && reloads+=("$cmd")
	done < <(targets)

	((reload)) || return 0
	for cmd in "${reloads[@]}"; do BIN=$BIN bash -c "$cmd" >/dev/null 2>&1; done
	"$BIN/sound" theme 2>/dev/null
	notify "Theme" "$name"
}

need envsubst
case "${1:-}" in
	--list)  list ;;
	--check) check ;;
	--ensure)
		while IFS='|' read -r _ file _; do
			[[ -f $CACHE/$file ]] || { apply "$(current | grep . || echo $DEFAULT)" 0; break; }
		done < <(targets)
		;;
	--no-reload) apply "${2:?theme name}" 0 ;;
	'')
		need fuzzel
		name=$(list | fuzzel --dmenu --prompt "theme  ") || exit 0
		[[ -n $name ]] && apply "$name" 1
		;;
	-*) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
	*) apply "$1" 1 ;;
esac
