#!/usr/bin/env bash
# Set up the sway desktop on top of a bare Arch Linux install.
# Safe to re-run. Nothing is touched with --dry-run.
#
#   ./install [--dry-run] [--yes] [--optional] [--fish] [--doctor]

set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/sway-desktop"    # configs find the scripts here
STAMP="$(date +%Y%m%d-%H%M%S)"

DRY_RUN=0 YES=0 OPTIONAL=0 FISH=0 DOCTOR=0
for arg in "$@"; do
	case "$arg" in
		--dry-run)  DRY_RUN=1 ;;
		--yes)      YES=1 ;;
		--optional) OPTIONAL=1 ;;
		--fish)     FISH=1 ;;
		--doctor)   DOCTOR=1 ;;
		-h | --help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "unknown option: $arg" >&2; exit 2 ;;
	esac
done

step() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '\033[1;33m    warning:\033[0m %s\n' "$*"; }
run()  { if ((DRY_RUN)); then printf '    [dry-run] %s\n' "$*"; else "$@"; fi; }

has_amdgpu() { ls /sys/bus/pci/drivers/amdgpu/0000:* >/dev/null 2>&1; }

# link <source> <destination>: an existing real file or directory is moved aside
link() {
	local src=$1 dst=$2
	if [[ -L $dst && "$(readlink -f "$dst")" == "$(readlink -f "$src")" ]]; then info "ok      $dst"; return; fi
	if [[ -e $dst || -L $dst ]]; then info "backup  $dst -> $dst.bak-$STAMP"; run mv "$dst" "$dst.bak-$STAMP"; fi
	info "link    $dst"
	run mkdir -p "$(dirname "$dst")"
	run ln -s "$src" "$dst"
}

# seed <source> <destination>: copied once, never overwritten
seed() {
	local src=$1 dst=$2
	if [[ -e $dst ]]; then info "keep    $dst"; return; fi
	info "seed    $dst"
	run install -Dm644 "$src" "$dst"
}

doctor() {
	step "Doctor"
	local fails=0
	check() { local desc=$1; shift
		if "$@" >/dev/null 2>&1; then printf '    \033[32mok\033[0m    %s\n' "$desc"
		else printf '    \033[31mFAIL\033[0m  %s\n' "$desc"; fails=$((fails + 1)); fi; }
	check "scripts reachable at $SHARE"          test -x "$SHARE/bin/theme"
	check "keybinding tables are valid"          "$REPO/bin/keys" --check
	check "palettes and templates are valid"     "$REPO/bin/theme" --check
	check "sway config parses"                   sh -c "'$REPO/bin/keys' build && '$REPO/bin/theme' --ensure && sway -C"
	check "JetBrainsMono Nerd Font resolves"     sh -c "fc-match 'JetBrainsMono Nerd Font' family | grep -q JetBrainsMono"
	check "sway-session.target installed"        test -e "$CONFIG/systemd/user/sway-session.target"
	check "PipeWire is running"                  sh -c "wpctl status | grep -q PipeWire"
	check "monitor answers over DDC/CI"          sh -c "ddcutil detect --brief 2>/dev/null | grep -q 'I2C bus'"
	check "login unlocks the keyring (PAM)"      sh -c "test -e /usr/lib/security/pam_gnome_keyring.so && grep -qs pam_gnome_keyring /etc/pam.d/ly"
	check "a login manager is enabled"           sh -c "systemctl is-enabled display-manager.service || systemctl is-enabled ly@tty2.service"
	if ((fails)); then warn "$fails check(s) failed. Audio, DDC and sway checks need a logged-in session: re-run './install --doctor' after the first login."
	else info "all checks passed"; fi
}

((EUID != 0)) || { echo "Run this as your normal user; it calls sudo where it needs root." >&2; exit 1; }
for cmd in pacman sudo; do command -v "$cmd" >/dev/null || { echo "$cmd not found; this script targets Arch Linux." >&2; exit 1; }; done
if ((DOCTOR)); then doctor; exit 0; fi

# --- packages --------------------------------------------------------------

step "Packages"
lists=("$REPO/packages/base.txt" "$REPO/packages/desktop.txt" "$REPO/packages/apps.txt")
((OPTIONAL)) && lists+=("$REPO/packages/optional.txt")
mapfile -t pkgs < <(grep -hvE '^\s*(#|$)' "${lists[@]}")
if ! has_amdgpu; then
	warn "no GPU on the amdgpu driver: skipping the AMD packages"
	mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | grep -vxE 'vulkan-radeon|linux-firmware-amdgpu|amd-ucode')
fi
# the bar's network click opens nm-connection-editor; the network stack itself is left alone
systemctl is-active --quiet NetworkManager.service && pkgs+=(network-manager-applet)

pacman_args=(-Syu --needed)      # -Syu, not -S: never a partial upgrade
((YES)) && pacman_args+=(--noconfirm)
info "${#pkgs[@]} packages"
run sudo pacman "${pacman_args[@]}" "${pkgs[@]}"

# --- configuration ---------------------------------------------------------

step "Scripts"
link "$REPO" "$SHARE"

step "Configuration"
# config/ mirrors ~/.config: every directory in it is linked, so adding a tool is adding a folder
for dir in "$REPO"/config/*/; do
	name=$(basename "$dir")
	case "$name" in
		systemd) for unit in "$dir"user/*; do link "$unit" "$CONFIG/systemd/user/$(basename "$unit")"; done ;;
		*)       link "${dir%/}" "$CONFIG/$name" ;;
	esac
done

step "Generated files"
run "$REPO/bin/keys" build
run "$REPO/bin/theme" --ensure

step "Seeds (copied once, then owned by their tools)"
seed "$REPO/seeds/gtk-3.0/settings.ini"   "$CONFIG/gtk-3.0/settings.ini"
seed "$REPO/seeds/gtk-4.0/settings.ini"   "$CONFIG/gtk-4.0/settings.ini"
seed "$REPO/seeds/qt6ct/qt6ct.conf"       "$CONFIG/qt6ct/qt6ct.conf"
seed "$REPO/seeds/Kvantum/kvantum.kvconfig" "$CONFIG/Kvantum/kvantum.kvconfig"
seed "$REPO/seeds/icons-default/index.theme" "$HOME/.icons/default/index.theme"
seed "$REPO/seeds/xdg-desktop-portal/sway-portals.conf" "$CONFIG/xdg-desktop-portal/sway-portals.conf"
# Chromium, VS Code and Electron do not recognise sway as a desktop; pin their
# secret store to the keyring. Skipped where KWallet already holds their keys.
if ! pacman -Qq kwallet >/dev/null 2>&1; then
	for flags in chromium-flags.conf brave-flags.conf chrome-flags.conf electron-flags.conf code-flags.conf codium-flags.conf; do
		seed "$REPO/seeds/browser/flags.conf" "$CONFIG/$flags"
	done
	for dir in .vscode .vscode-oss; do seed "$REPO/seeds/browser/argv.json" "$HOME/$dir/argv.json"; done
fi

step "Session"
run xdg-user-dirs-update
run gsettings set org.gnome.desktop.interface color-scheme prefer-dark || warn "gsettings failed (no session bus?); set it once with nwg-look after login"
run gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark || true
run gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark || true
if ((DRY_RUN)) || systemctl --user daemon-reload 2>/dev/null; then
	run systemctl --user enable gnome-keyring-daemon.socket || warn "could not enable gnome-keyring-daemon.socket"
fi

step "Login manager"
if systemctl is-enabled --quiet display-manager.service 2>/dev/null; then info "a display manager is already enabled, leaving it alone"
elif systemctl is-enabled --quiet ly@tty2.service 2>/dev/null; then info "ok      ly@tty2.service"
else run sudo systemctl enable ly@tty2.service; fi     # enabled, not started: starting it would take this terminal away

if ((FISH)); then
	step "Login shell"
	[[ "$(getent passwd "$USER" | cut -d: -f7)" == /usr/bin/fish ]] && info "ok      fish" || run chsh -s /usr/bin/fish
fi

((DRY_RUN)) || doctor
step "Done"
info "Reboot (or log out), pick the sway session at the login screen and log in."
info "Mod+Shift+Space lists every key. Wallpaper: ~/.config/sway-desktop/wallpaper.png"
