# wofi: app launcher (Mod+Space) and the dmenu behind the key list, window
# switcher, theme picker, session menu and clipboard history.
# Colours: colors.css, written by ~/.config/sway/scripts/theme; layout: style.css
mode=drun
prompt=Search
allow_images=true
image_size=20
insensitive=true
matching=contains
hide_scroll=true
no_actions=true
term=foot
width=600
height=420
location=center
lines=10
